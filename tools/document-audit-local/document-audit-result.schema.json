{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apdb.example/schemas/local-document-audit-result.json",
  "title": "APdB local document audit result",
  "type": "object",
  "required": ["schema_version", "audit_status", "human_decision_required", "identity_comparison", "observations", "doubts", "documents", "checks"],
  "properties": {
    "schema_version": { "const": "apdb-local-document-audit/1.0" },
    "audit_status": { "enum": ["listo_aprobar", "revisar", "error"] },
    "human_decision_required": { "const": true },
    "identity_comparison": { "enum": ["coincidente", "inconsistente", "no_concluyente"] },
    "observations": { "type": "array", "items": { "type": "string" } },
    "doubts": { "type": "array", "items": { "type": "string" } },
    "documents": { "type": "array", "minItems": 2 },
    "checks": { "type": "object" }
  },
  "additionalProperties": false
}
